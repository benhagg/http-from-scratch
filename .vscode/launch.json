{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug server (Docker)",
      "type": "cppdbg",
      "request": "launch",
      "program": "/app/server",
      "cwd": "/app",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "pipeTransport": {
        "pipeProgram": "docker",
        "pipeCwd": "${workspaceFolder}",
        "pipeArgs": ["compose", "exec", "-T", "server", "sh", "-c"],
        "debuggerPath": "/usr/bin/gdb"
      },
      "sourceFileMap": {
        "/app": "${workspaceFolder}"
      },
      "externalConsole": false
    },
    {
      "name": "Debug client (Docker)",
      "type": "cppdbg",
      "request": "launch",
      "program": "/app/client",
      "cwd": "/app",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "pipeTransport": {
        "pipeProgram": "docker",
        "pipeCwd": "${workspaceFolder}",
        "pipeArgs": ["compose", "exec", "-T", "client", "sh", "-c"],
        "debuggerPath": "/usr/bin/gdb"
      },
      "sourceFileMap": {
        "/app": "${workspaceFolder}"
      },
      "externalConsole": false
    }
  ]
}
